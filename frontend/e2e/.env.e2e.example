# Copy to `.env.e2e` (gitignored) and fill in. Real env vars override this file.

# --- Target --------------------------------------------------------------
# App under test. Default is the dev Vercel deployment.
E2E_BASE_URL=https://ecalt-dev.vercel.app

# --- Vercel deployment protection ---------------------------------------
# Vercel → project ecalt → Settings → Deployment Protection →
#   "Protection Bypass for Automation" → generate a secret.
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- Firebase: minting the session --------------------------------------
# Path to the ecalt-dev Firebase service-account JSON (Firebase console →
# Project settings → Service accounts → Generate new private key). Save it
# somewhere gitignored, e.g. frontend/e2e/service-account.json.
FIREBASE_SERVICE_ACCOUNT=./e2e/service-account.json

# The dev deployment's Firebase WEB config (Firebase console → Project
# settings → General → Your apps). apiKey is required; the others have
# ecalt-dev defaults.
E2E_FIREBASE_API_KEY=
E2E_FIREBASE_AUTH_DOMAIN=ecalt-dev.firebaseapp.com
E2E_FIREBASE_PROJECT_ID=ecalt-dev

# Test user to sign in as. Email is looked up via Admin to get the uid;
# set E2E_USER_UID to skip the lookup.
E2E_USER_EMAIL=developer.biswambar@gmail.com
# E2E_USER_UID=

# Pulled from the CDN by the auth setup — keep in sync with `firebase` in
# package.json (currently 12.13.0).
E2E_FIREBASE_SDK_VERSION=12.13.0

# --- Test fixtures on dev ------------------------------------------------
E2E_SCHOOL_ID=1b48bd4b-60d9-43ed-a569-f80147c760c4
E2E_SCHOOL_NAME=Invite Test School
