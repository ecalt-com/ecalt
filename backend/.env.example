ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Firebase — same project ID as the frontend
FIREBASE_PROJECT_ID=your-project-id

# Supabase — direct psycopg2 connection (preferred: pooler URL)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
# Fallback individual params (used if DATABASE_URL is not set)
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password

# Sentry error tracking (optional)
SENTRY_DSN=

# Stripe payments (global)
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# Razorpay payments (India)
# Create test keys at https://dashboard.razorpay.com — test mode is on by default
# Set RAZORPAY_WEBHOOK_SECRET after creating the webhook in the Razorpay dashboard
RAZORPAY_KEY_ID=rzp_test_your-key-id-here
RAZORPAY_KEY_SECRET=your-razorpay-secret-here
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here

# ── Notification channels ────────────────────────────────────────────────────

# Brevo — transactional email (HTTP API preferred over SMTP)
BREVO_API_KEY=your-brevo-api-key-here
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your-smtp-login@smtp-brevo.com
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM_EMAIL=noreply@ecalt.app

# Twilio — WhatsApp messages via the Twilio WhatsApp Business API
# Sandbox number for dev: whatsapp:+14155238886
# Replace with your approved WhatsApp Business number in production
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Secret used to sign one-click unsubscribe tokens (change in production)
NOTIFICATION_SIGNING_SECRET=change-me-in-production

# Global channel kill-switches — set to false to disable a channel entirely
# (overrides individual user preferences; useful during rollout)
NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_WHATSAPP_ENABLED=true
# Run the APScheduler notification jobs in this instance. Exactly one
# instance (production) should have this true — a second scheduler against
# the same DB races the daily-cap check and double-sends emails.
SCHEDULER_ENABLED=false
